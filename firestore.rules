rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProvider() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider';
    }

    function isActiveUser() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isValidEmail(email) {
      return email != null && email.matches('.*@.*\\..*');
    }

    function hasValidTimestamp(data) {
      return data.keys().hasAny(['createdAt', 'updatedAt']) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isProviderAssignedToLocation(providerId, locationId) {
      return get(/databases/$(database)/documents/locations/$(locationId)).data.assignedProviders.hasAny([providerId]);
    }

    function serviceExists(serviceId) {
      return get(/databases/$(database)/documents/services/$(serviceId)).data != null;
    }

    function isActiveService(serviceId) {
      return serviceExists(serviceId) && get(/databases/$(database)/documents/services/$(serviceId)).data.isActive != false;
    }

    function isActiveLocation(locationId) {
      return get(/databases/$(database)/documents/locations/$(locationId)).data.active != false;
    }

    function isValidPushSubscription(data) {
      return data.endpoint is string &&
        data.keys is map &&
        data.keys.p256dh is string &&
        data.keys.auth is string &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Users collection rules - Enhanced security per PRD
    match /users/{userId} {
      allow create: if isOwner(userId) && 
                       isValidEmail(request.resource.data.email) &&
                       hasValidTimestamp(request.resource.data) &&
                       request.resource.data.role in ['provider', 'admin'] &&
                       request.resource.data.displayName is string &&
                       request.resource.data.email is string &&
                       request.resource.data.uid == userId;
      
      allow read: if isOwner(userId) || isAdmin();
      
      allow update: if (isOwner(userId) && 
                       // Users can only update specific fields
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'photoURL', 'lastActiveAt', 'updatedAt', 'autoGeofenceCheckEnabled'])) ||
                       (isAdmin() && hasValidTimestamp(request.resource.data));
      
      allow delete: if isAdmin();
      
      // List operations for admins only
      allow list: if isAdmin();
    }

    // Push subscriptions (per-user subcollection)
    match /users/{userId}/pushSubscriptions/{subscriptionId} {
      allow create, update, delete: if isOwner(userId) && isValidPushSubscription(request.resource.data);
      allow get, list, read: if isOwner(userId) || isAdmin();
    }

    // Locations collection rules - Simplified to use only assignedProviders
    match /locations/{locationId} {
      // Providers can read locations they are assigned to; admins can read all
      allow get, read: if isAuthenticated() &&
                          (isAdmin() || 
                           (isProvider() && resource.data.assignedProviders.hasAny([request.auth.uid])));
      
      // Only admins can create/update/delete locations
      allow create, update: if isAdmin() && 
                              hasValidTimestamp(request.resource.data) &&
                              request.resource.data.geo != null && // GeoPoint validation
                              request.resource.data.name is string &&
                              request.resource.data.address is string &&
                              request.resource.data.assignedProviders is list;
      
      allow delete: if isAdmin();
      
      // List operations - admins can list all, providers only with array-contains query
      allow list: if isAdmin() || 
                    (isProvider() && 
                     request.query.limit != null &&
                     request.query.orderBy != null &&
                     request.query.where.path == "assignedProviders" && 
                     request.query.where.op == "array-contains" && 
                     request.query.where.value == request.auth.uid);
    }

    // Sessions collection rules - Enhanced validation per PRD
    match /sessions/{sessionId} {
      allow create: if isAuthenticated() && 
                       isProvider() &&
                       isActiveUser() &&
                       request.auth.uid == request.resource.data.userId &&
                       isProviderAssignedToLocation(request.auth.uid, request.resource.data.locationId) &&
                       isActiveLocation(request.resource.data.locationId) &&
                       hasValidTimestamp(request.resource.data) &&
                       request.resource.data.status in ['active'] && // Only allow creating active sessions
                       request.resource.data.locationId is string &&
                       request.resource.data.startTime is timestamp &&
                       request.resource.data.checkInMethod in ['geo', 'offline-sync'] &&
                       request.resource.data.distanceFromCenterAtCheckIn is number &&
                       request.resource.data.dayKey is string;
      
      allow read: if isAuthenticated() &&
                     (isOwner(resource.data.userId) || isAdmin());
      
      allow update: if isAuthenticated() &&
                       hasValidTimestamp(request.resource.data) &&
                       (
                         // Providers can only update their own sessions with valid transitions
                         (isOwner(resource.data.userId) && 
                          isProvider() &&
                          resource.data.status != 'completed' && // Cannot update completed sessions
                          (
                            // Valid state transitions for providers
                            (resource.data.status == 'active' && request.resource.data.status in ['paused', 'completed']) ||
                            (resource.data.status == 'paused' && request.resource.data.status in ['active', 'completed'])
                          )) ||
                        // Admins have full control over all sessions and transitions
                        (isAdmin() && request.resource.data.status in ['active', 'paused', 'completed', 'cancelled', 'error'])
                       );
      
      allow delete: if isAdmin();
      
      // List operations - admins can list all, providers can query their own sessions
      // Explicitly allow real-time queries for active/paused/completed sessions by userId
      allow list: if isAdmin() || 
                     (isProvider() && isActiveUser());
    }

    // Feedback collection rules
    match /feedback/{feedbackId} {
      // Authenticated users (providers/admins) can create feedback
      allow create: if isAuthenticated() &&
                       request.resource.data.providerId == request.auth.uid &&
                       request.resource.data.description is string &&
                       request.resource.data.category in ['bug', 'feature_request', 'general', 'other'] &&
                       request.resource.data.severity in ['low', 'medium', 'high', 'critical'] &&
                       request.resource.data.status == 'open' &&
                       hasValidTimestamp(request.resource.data);

      // Admins can read/update/delete all feedback
      allow read, update, delete: if isAdmin();
      
      // Admins can update feedback status
      allow update: if isAdmin() &&
                      hasValidTimestamp(request.resource.data) &&
                      request.resource.data.status in ['open', 'in_progress', 'resolved', 'closed'];
    }

    // Services collection rules
    match /services/{serviceId} {
      // Authenticated users can read services
      allow read: if isAuthenticated();

      // Only admins can write
      allow create, update, delete: if isAdmin() &&
        hasValidTimestamp(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.code is string &&
        request.resource.data.isActive is bool;

      // List operations allowed for authenticated users
      allow list: if isAuthenticated();
    }

    // Schedules collection rules
    match /schedules/{scheduleId} {
      // Admins can read all; providers can read their own schedules
      allow read: if isAdmin() ||
                    (isProvider() && resource.data.providerId == request.auth.uid);

      // Only admins can create schedules with validation
      allow create: if isAdmin() &&
        hasValidTimestamp(request.resource.data) &&
        request.resource.data.providerId is string &&
        request.resource.data.locationId is string &&
        request.resource.data.serviceId is string &&
        request.resource.data.dayOfWeek >= 0 &&
        request.resource.data.dayOfWeek <= 6 &&
        request.resource.data.startTime is string &&
        request.resource.data.endTime is string &&
        request.resource.data.createdBy is string &&
        isProviderAssignedToLocation(request.resource.data.providerId, request.resource.data.locationId) &&
        isActiveService(request.resource.data.serviceId);

      // Only admins can update schedules
      allow update: if isAdmin() &&
        hasValidTimestamp(request.resource.data);

      // Only admins can delete schedules
      allow delete: if isAdmin();

      // List operations
      allow list: if isAdmin() ||
        (isProvider() &&
          request.query.where.path == "providerId" &&
          request.query.where.value == request.auth.uid);
    }

    // Assignments collection - DEPRECATED
    // Use Location.assignedProviders instead
    // Keeping rules for backward compatibility during migration
    match /assignments/{assignmentId} {
      allow read, write: if isAdmin();
    }

    // System metadata collection for analytics (admin only)
    match /system/{document} {
      allow read, write: if isAdmin();
    }

    // Cache metadata collection for performance monitoring
    match /cache_stats/{document} {
      allow read, write: if isAdmin();
    }

    // Rate limiting collection
    match /rate_limits/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Report schedules collection (Admin only)
    match /reportSchedules/{scheduleId} {
      allow read, list: if isAdmin();
      
      allow create: if isAdmin() &&
        hasValidTimestamp(request.resource.data) &&
        request.resource.data.name is string &&
        request.resource.data.reportType in ['sessions', 'attendance', 'analytics', 'management'] &&
        request.resource.data.frequency in ['daily', 'weekly', 'monthly', 'quarterly'] &&
        request.resource.data.deliveryTime is string &&
        request.resource.data.recipients is list &&
        request.resource.data.format in ['pdf', 'csv', 'excel'] &&
        request.resource.data.isActive is bool &&
        request.resource.data.createdBy is string;
      
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }
  }
}
